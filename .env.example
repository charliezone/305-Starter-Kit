# ===========================================
# 305 Starter Kit - Environment Variables
# See README.md > Setup Guide for step-by-step instructions
# ===========================================

# --- Supabase (REQUIRED) ---
# Get these from: supabase.com > Your Project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- Database (REQUIRED) ---
# Get from: supabase.com > Your Project > Settings > Database > Connection string > Direct
# Replace [YOUR-PASSWORD] with the password you set when creating the Supabase project
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# --- Stripe (REQUIRED) ---
# Get from: stripe.com > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret — for local dev: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# For production: stripe.com > Developers > Webhooks > Your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# --- OpenAI (REQUIRED for AI features) ---
# Get from: platform.openai.com > API keys > Create new secret key
OPENAI_API_KEY=sk-proj-...

# --- Resend (OPTIONAL — for transactional emails) ---
# Get from: resend.com > API Keys > Create API Key
# For production, verify your domain at resend.com > Domains
RESEND_API_KEY=re_...
EMAIL_FROM=YourApp <onboarding@resend.dev>

# --- Admin (OPTIONAL) ---
# Comma-separated list of emails that can access /admin
ADMIN_EMAILS=you@example.com

# --- Stripe Price IDs (REQUIRED for billing page) ---
# Create products at: stripe.com > Product catalog > Add product
# Each product needs a recurring monthly price — copy the Price ID (price_...)
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_...
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_...

# --- App URL ---
# Development: http://localhost:3000
# Production: your deployed URL (e.g., https://yourapp.onrender.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
